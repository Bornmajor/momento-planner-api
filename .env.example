# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/momento

# Auth — JWT secret must be at least 32 bytes of randomness, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated Google OAuth client IDs (web, android, ios) accepted as ID-token audiences
GOOGLE_CLIENT_IDS=

# Ticketmaster Discovery API (consumer key)
TICKETMASTER_API_KEY=

# AI — leave ANTHROPIC_API_KEY empty to use the fake AI provider in dev
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_DAILY_LIMIT_PER_USER=20

CORS_ORIGINS=
